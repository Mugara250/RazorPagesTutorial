@page "/PizzaOrder"
@model RazorPagesTutorial.Pages.Pizza.PizzaOrder;
@{
    ViewData["Title"] = "Pizza Order Page";
}

<!DOCTYPE html>

<html lang="en">
<head>
    <title>Pizza-Order</title>
</head>
<body>
<div>
    <h1 class="text-center">Codecademy Pizza</h1>
    <br/>
    <h1>Available pizza</h1>
    <ul>
        @foreach (var pizza in @Model._PizzaData.GetAll())
        {
            <li>@pizza</li>
        }
    </ul>
    <br>
    <div class="mx-auto" style="width: 18rem;">
        <img src="https://static-assets.codecademy.com/curriculum/asp/pizza.svg" class="card-img-top-center" alt="pizza icon" style="width: 50px; height: 50px;">
        <div class="">
            <h4 class="text-center">Confirm your order</h4>
            <br>
            <h5>Pizza for: @Model.Customer</h5>
            <h5>Order: @Model.Order</h5>
            <h5>Extra Cheese: @Model.ExtraCheese</h5>
            @* <h5>Total: $@string.Format("{0:0.00}", Model.Total)</h5> *@
            <h5>Total: $@((object)$"{Model.Total:0.00}")</h5>
            <br>
            <a href="#" class="btn btn-primary">Place Order</a>
            <br/>
            <h1>This is a partial</h1>
            <partial name="_PartialTest"/>
            <a asp-page="/Pizza/IndividualPizza/IndividualPizza">Individual</a>
            <div class="jumbotron jumbotron-fluid" id="archive-jumbotron">
                <div id="jumbotron-main-text">
                    <h1>Archive</h1>
                    <p>The best past recipes!</p>
                </div>
            </div>
            <div class="col">
                <!-- Page model properties displayed here -->
                <div class="blog-post">
                    <h3 class="blog-post-title">@Model.Displayed.Title</h3>
                    <p class="blog-post-meta">Posted on @Model.Displayed.Date.ToShortDateString()</p>
                    <p>@Model.Displayed.Body</p>
                </div>
            </div>
            <div class="col">
                <h1>Older posts</h1>
                <hr>
                @for (int i = 0; i < Model.Archive.Count; i++)
                {
                    <div>
                        <h3>
                            <!-- Use asp-page and asp-route-index here -->
                            <a asp-page="/Pizza" asp-route-index="@i">@Model.Archive[i].Title</a>
                        </h3>
                        <p>Posted on @Model.Archive[i].Date.ToShortDateString()</p>
                    </div>
                }
            </div>
        </div>
    </div> 
</div>
</body>
</html>