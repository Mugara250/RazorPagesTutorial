@using BlazorServerTutorial.Models
@using BlazorServerTutorial.Services
@inject ClientService ClientService
@inject ClientPreferencesService PreferencesService
@implements IDisposable

@if (_isLoading)
{
    <div>
        <p>Loading clients...</p>
    </div>
}
else
{
    <div>
        <label>
            <input @bind="PreferencesService.ShowActiveOnly" type="checkbox" />
            Show Active Clients Only
        </label>
    </div>

    <div>
        @foreach (var client in _clients)
        {
            @if (!PreferencesService.ShowActiveOnly || client.IsActive)
            {
                <ClientCard @key="client.Id"
                            Name="@client.Name"
                            Email="@client.Email"
                            Company="@client.Company"
                            IsActive="@client.IsActive"
                            ClientId="@client.Id"
                            OnToggleStatus="@(() => client.IsActive = !client.IsActive)"
                            OnDetailsRequested="@OnDetailsRequested"/>
            }
        }
    </div>

    @if (!_clients.Any(c => !_showActiveOnly || c.IsActive))
    {
        <div>
            <p>No clients found matching your criteria.</p>
            <a href="/clients/add">Add Your First Client</a>
        </div>
    }   
}


@code {
    private bool _showActiveOnly = false;
    private List<Client> _clients = new List<Client>();
    private bool _isLoading = true;
    [Parameter] public EventCallback<int> OnDetailsRequested { get; set; }
    protected override void OnInitialized()
    {
        PreferencesService.OnStateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        PreferencesService.OnStateChanged -= StateHasChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        _clients = await ClientService.GetAllClientsAsync();
        _isLoading = false;
    }

}