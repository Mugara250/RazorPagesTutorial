@page "/"
@using BlazorServerTutorial.Components.Shared
@rendermode InteractiveServer

<PageTitle>Client Manager</PageTitle>

<div>
    <h1>Welcome to Client Manager</h1>
    <p>Manage your clients with advanced Blazor Server features</p>
  
    <div>
        <a href="/client/add">Add New Client</a>
    </div>
</div>

<div>
    <h2>Your Clients</h2>
    <ClientList OnDetailsRequested="@HandleDetailsRequested" />
</div>

@inject NavigationManager Navigation

@code
{
    private Task HandleDetailsRequested(int clientId)
    {
        try
        {
            Navigation.NavigateTo($"/client/{clientId}");
            return Task.CompletedTask;
        }
        catch (Exception exception)
        {
            return Task.FromException(exception);
        }
    }
}
